{
  "name": "abbadon",
  "productName": "Abbadon",
  "desktopName": "abbadon.desktop",
  "private": true,
  "version": "1.0.16",
  "description": "Desktop SoundCloud player with rate-limit protection",
  "author": "Abbadon",
  "license": "MIT",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "test": "node scripts/test-all.cjs",
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "electron": "electron .",
    "app": "npm run build && electron .",
    "pack": "npm run build && electron-builder --dir",
    "pack:linux": "npm run build && electron-builder --linux --dir",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:linux": "npm run build && electron-builder --linux",
    "dist:deb": "npm run build && electron-builder --linux deb",
    "dist:appimage": "npm run build && electron-builder --linux AppImage",
    "dist:rpm": "npm run build && electron-builder --linux rpm",
    "dist:all": "npm run build && electron-builder -mwl",
    "release": "npm run build && electron-builder --publish always",
    "release:win": "npm run build && electron-builder --win --publish always",
    "release:linux": "npm run build && electron-builder --linux --publish always"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "wait-on": "^9.5.1"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "discord-rpc": "^4.0.1",
    "electron-updater": "^6.8.9",
    "hls.js": "^1.7.3",
    "lucide-react": "^1.49.0",
    "node-id3": "^0.2.9",
    "peerjs": "^1.5.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "build": {
    "appId": "com.abbadon.player",
    "productName": "Abbadon",
    "publish": [
      {
        "provider": "github",
        "owner": "Xertoo",
        "repo": "abbadon",
        "private": false
      }
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/icon.png",
        "to": "icon.png"
      }
    ],
    "asarUnpack": [
      "electron/bin/**/*"
    ],
    "protocols": [
      {
        "name": "Abbadon Protocol",
        "schemes": [
          "abbadon"
        ]
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "signExecutable": false,
      "forceCodeSigning": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Abbadon",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Abbadon-portable.exe"
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "AudioVideo",
      "synopsis": "Desktop SoundCloud player with rate-limit protection",
      "description": "Desktop SoundCloud player with rate-limit protection, native stream resolver, and rich integrations",
      "maintainer": "Abbadon <xertoo@users.noreply.github.com>",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "rpm",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "tar.gz",
          "arch": [
            "x64"
          ]
        }
      ],
      "desktop": {
        "entry": {
          "StartupWMClass": "abbadon"
        }
      },
      "syncDesktopName": true,
      "executableName": "abbadon"
    },
    "deb": {
      "compression": "gz",
      "priority": "optional",
      "packageCategory": "sound",
      "depends": [
        "libnotify4",
        "libxtst6",
        "libnss3",
        "libasound2 | libasound2t64"
      ],
      "artifactName": "${name}_${version}_${arch}.${ext}"
    },
    "rpm": {
      "compression": "gzip",
      "artifactName": "${name}-${version}.${arch}.${ext}"
    },
    "appImage": {
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    }
  }
}
