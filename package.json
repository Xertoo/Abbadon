{
  "name": "abbadon",
  "productName": "Abbadon",
  "private": true,
  "version": "1.0.4",
  "description": "Desktop SoundCloud player with rate-limit protection",
  "author": "Abbadon",
  "license": "MIT",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "electron": "electron .",
    "app": "npm run build && electron .",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder --win",
    "release": "npm run build && electron-builder --win --publish always"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "wait-on": "^9.5.1"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "discord-rpc": "^4.0.1",
    "electron-updater": "^6.8.9",
    "hls.js": "^1.7.3",
    "lucide-react": "^1.49.0",
    "peerjs": "^1.5.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "build": {
    "appId": "com.abbadon.player",
    "productName": "Abbadon",
    "publish": [
      {
        "provider": "github",
        "owner": "Xertoo",
        "repo": "abbadon",
        "private": false
      }
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "signExecutable": false,
      "forceCodeSigning": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Abbadon",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "Abbadon-portable.exe"
    }
  }
}
